@{
    ViewData["Title"] = "Sipariş Tamamlandı";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-lg p-5 text-center">
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        </div>
        <h1 class="display-4 fw-bold text-success">Siparişiniz Tamamlandı!</h1>
        <p class="lead text-muted mb-4">Teşekkür ederiz! Siparişiniz başarıyla alındı ve üreticilerimize iletildi. En kısa sürede sizinle iletişime geçilecektir.</p>
        
        <div class="alert alert-success border-0 bg-opacity-10 text-success p-4 mb-4">
            <strong>Sipariş Numaranız:</strong> #@(new Random().Next(10000, 99999))
        </div>

        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-success btn-lg px-5 gap-3">
                <i class="bi bi-house-door"></i> Ana Sayfaya Dön
            </a>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                Yeni Ürünlere Göz At
            </a>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }
    .card {
        animation: slideUp 0.5s ease-out;
    }
    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
